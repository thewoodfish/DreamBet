# Privy app ID, from the Privy dashboard. Public by design (it ships to the
# browser) — the app secret is NOT needed here and must never be committed.
NEXT_PUBLIC_PRIVY_APP_ID=

# Which Somnia network to trade on.
#   testnet -> Shannon, chain 50312, collateral tUSDC (6dp)
#   mainnet -> chain 5031, collateral USDso (18dp)
# tUSDC is minted from the app's own wallet sheet, which calls the TestUSDC
# faucet directly. Gas is sponsored — see GAS_SPONSOR_PRIVATE_KEY below.
NEXT_PUBLIC_SOMNIA_NETWORK=testnet

# Telegram bot and Mini App short name, used to build challenge links:
#   https://t.me/<BOT>/<APP>?startapp=<challenge>
# Both come from BotFather. Unset, challenges still work — the link points at
# this app's own origin instead of the Mini App, which is what a browser
# preview wants anyway.
NEXT_PUBLIC_TELEGRAM_BOT=
NEXT_PUBLIC_TELEGRAM_APP=

# --- Gas sponsorship (server only — never NEXT_PUBLIC_) ---
# A wallet created behind a Telegram login cannot buy its own gas: every public
# STT faucet wants a browser wallet to connect, and a Mini App has none. So one
# funded key underwrites every player's first transactions.
#
# Fund the address it derives from with STT (GET /api/fund reports the address
# and how many players are left in it). Unset, the app still runs — players
# just have to arrive with gas of their own.
ive done 

# What a funded wallet is topped up to. Default 0.15. Sized against a ceiling,
# not a cost: the markets SDK sends every order with a 10,000,000 gas ceiling
# and Somnia charges a flat 6 gwei, so the chain demands 0.06 STT be on hand
# before it accepts an order — however little it actually burns.
GAS_SPONSOR_TARGET_STT=

# Bot token from BotFather, used ONLY to verify Telegram's signature on a
# launch payload before spending gas on it. Set this before exposing the app
# publicly: without it, /api/fund will drip to any address that asks.
TELEGRAM_BOT_TOKEN=
