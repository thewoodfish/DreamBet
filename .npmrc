# Privy pulls `permissionless` as an OPTIONAL peer (account abstraction, which
# this app does not use), and permissionless in turn wants ox@^0.8 while viem —
# required by @somnia-chain/markets-sdk — is on ox@0.14. The conflict is entirely
# between optional peers of a package we never import, so npm's strict peer
# resolution is refusing an install that is actually fine.
legacy-peer-deps=true
